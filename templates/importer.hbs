<div class="custom-importer">
<h1>Add Custom Character Content</h1>
<p>Add homebrew directly to this character builder. Choose the rules version and content type, or load a JSON, PDF or Markdown file first.</p>
<div class="rule-cards">
<label><input type="radio" name="rules" value="2014" {{#if (eq data.rules "2014")}}checked{{/if}}><strong>D&D 5e — 2014 / Legacy</strong></label>
<label><input type="radio" name="rules" value="2024" {{#if (eq data.rules "2024")}}checked{{/if}}><strong>D&D 2024 / 5.5e</strong></label>
</div>
<div class="import-grid">
<label>Import JSON<input type="file" name="json" accept=".json,application/json"></label>
<label>Import PDF<input type="file" name="pdf" accept=".pdf,application/pdf"></label>
<label>Import Markdown<input type="file" name="markdown" accept=".md,.markdown,.txt,text/markdown,text/plain"></label>
</div>
<label>What are you adding?
<select name="type">
{{#each types}}<option value="{{value}}" {{#if (eq ../data.type value)}}selected{{/if}}>{{label}}</option>{{/each}}
</select></label>
<label>Name<input name="name" value="{{data.name}}" placeholder="Homebrew name"></label>
{{#if isSubclass}}<label>Which class does this subclass belong to?
<select name="classIdentifier"><option value="">Choose a class</option>{{#each classes}}<option value="{{identifier}}" {{#if (eq ../data.classIdentifier identifier)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/if}}
{{#if hasRaw}}<p class="raw-note"><i class="fas fa-circle-check"></i> Loaded a full Foundry item from JSON — its damage, activities and other data will be kept.
{{#if multiRaw}}<label class="inline-check"><input type="checkbox" name="importAll" {{#if importAll}}checked{{/if}}> Import all {{rawCount}} items in the file exactly as exported</label>{{/if}}</p>{{/if}}
{{#if isClass}}
<div class="opt-grid">
  <label>Hit Die<select name="hitDie">{{#each hitDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
  <label>Skills to choose<input type="number" name="skillCount" min="0" max="6" value="{{data.skillCount}}"></label>
  <label>Identifier<input name="identifier" value="{{data.identifier}}" placeholder="auto from name"></label>
</div>
<div class="check-row"><strong>Saving throws</strong>{{#each saveOptions}}<label><input type="checkbox" name="opt-saves" value="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
<div class="check-row"><strong>Armor</strong>{{#each armorOptions}}<label><input type="checkbox" name="opt-armor" value="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
<div class="check-row"><strong>Weapons</strong>{{#each weaponOptions}}<label><input type="checkbox" name="opt-weapons" value="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
{{/if}}
{{#if isRace}}<div class="opt-grid">
  <label>Walking speed (ft)<input type="number" name="speed" min="0" step="5" value="{{data.speed}}"></label>
  <label>Darkvision (ft, blank for none)<input type="number" name="darkvision" min="0" step="10" value="{{data.darkvision}}"></label>
</div>{{/if}}
{{#if isFeat}}<label>Feat category<select name="featCategory">{{#each featCategories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
{{#if isSpell}}<div class="opt-grid">
  <label>Spell level<select name="spellLevel">{{#each spellLevels}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <label>School<select name="spellSchool">{{#each spellSchools}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
</div>{{/if}}
{{#if isWeapon}}<label>Weapon type<select name="weaponType">{{#each weaponTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
{{#if isEquipment}}<div class="opt-grid">
  <label>Equipment type<select name="equipType">{{#each equipTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  {{#if isArmor}}<label>Armor Class (base)<input type="number" name="armorValue" min="0" max="30" value="{{data.armorValue}}" placeholder="e.g. 14"></label>{{/if}}
</div>{{/if}}
{{#if isItem}}<label>Rarity<select name="rarity">{{#each rarities}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
{{#if isClassLike}}<label>Class / Subclass Features<textarea name="featureNames" rows="6" placeholder="One feature per line">{{data.featureNames}}</textarea></label>{{/if}}
<label>Content format
<select name="format">
<option value="markdown" {{#if (eq data.format "markdown")}}selected{{/if}}>Markdown</option>
<option value="text" {{#if (eq data.format "text")}}selected{{/if}}>Plain text</option>
<option value="html" {{#if (eq data.format "html")}}selected{{/if}}>HTML</option>
</select></label>
<label>Content<textarea name="description" rows="12" placeholder="Imported JSON/PDF/Markdown text or homebrew description. Markdown: **bold**, *italic*, # headings, - lists, | tables |">{{data.description}}</textarea></label>
<footer><button type="button" class="primary" data-action="save"><i class="fas fa-plus"></i> Add to Character Builder</button></footer>
</div>
