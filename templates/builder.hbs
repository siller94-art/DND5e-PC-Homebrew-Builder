<div class="pc-builder-layout">
<aside class="pc-builder-sidebar">
  <h2>Build Character</h2>
  <div class="progress">Step {{stepNumber}} of {{totalSteps}}</div>
  <ol>
    {{#each stepList}}<li class="{{#if active}}active{{/if}} {{#if done}}done{{/if}}">{{label}}</li>{{/each}}
  </ol>
  <button type="button" data-action="custom"><i class="fas fa-flask"></i> Custom Content</button>
</aside>
<main class="pc-builder-main">
<header><small>STEP {{stepNumber}} / {{totalSteps}}</small><h1>{{stepTitle}}</h1></header>

{{#if isRules}}
<section class="rule-cards">
<label><input type="radio" name="rules" value="2014" {{#if (eq draft.rules "2014")}}checked{{/if}}><strong>D&D 5e — 2014 / Legacy</strong><span>Use legacy-compatible classes, races, backgrounds and progression.</span></label>
<label><input type="radio" name="rules" value="2024" {{#if (eq draft.rules "2024")}}checked{{/if}}><strong>D&D 2024 / 5.5e</strong><span>Use modern D&D5e content and progression.</span></label>
</section>
{{/if}}

{{#if isIdentity}}
<section class="form-area identity-area">
<label>Character Name<input name="name" value="{{draft.name}}" placeholder="Character name"></label>
<div class="portrait-row">
  <div class="portrait-preview"><img src="{{portrait}}" alt="Character portrait"></div>
  <div class="portrait-controls">
    <strong>Portrait</strong>
    <label class="upload-button"><i class="fas fa-upload"></i> Upload Image<input type="file" name="portraitFile" accept="image/*" hidden></label>
    <button type="button" data-action="browsePortrait"><i class="fas fa-folder-open"></i> Browse Files</button>
    {{#if draft.img}}<button type="button" data-action="clearPortrait"><i class="fas fa-times"></i> Remove</button>{{/if}}
    <input name="img" value="{{draft.img}}" placeholder="or paste an image path / URL">
    <small>Used for the character portrait and token.</small>
  </div>
</div>
</section>
{{/if}}

{{#if isList}}
<nav class="source-filters">
<label class="edition-filter">Edition<select name="editionFilter">{{#each editions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
{{#each sourceButtons}}<button type="button" class="{{#if active}}active{{/if}}" data-action="filterSource" data-source="{{value}}">{{label}} <span>{{count}}</span></button>{{/each}}
{{#if customStep}}<button type="button" class="add-custom {{#if showCustom}}active{{/if}}" data-action="customEntry"><i class="fas fa-plus"></i> Add Custom {{customStep.label}}</button>{{/if}}
</nav>
{{/if}}

{{#if showCustom}}
<section class="custom-entry">
<label class="custom-pick"><input type="radio" name="{{step}}" value="__custom__" {{#if customSelected}}checked{{/if}}><span><strong>Use custom {{customStep.label}}</strong><small>Homebrew · {{customStep.type}}</small></span></label>
<label>{{customStep.label}} Name<input name="customName" value="{{custom.name}}" placeholder="e.g. Coralborn"></label>
{{#if customStep.hitDie}}<label>Hit Die<select name="customHitDie">{{#each hitDice}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/if}}
<label>Description <small>(Markdown supported)</small><textarea name="customDescription" rows="6" placeholder="{{customStep.placeholder}}">{{custom.description}}</textarea></label>
{{#if isGM}}<label class="inline-check"><input type="checkbox" name="customSave" {{#if custom.save}}checked{{/if}}> Also save to the world so it can be reused</label>{{/if}}
</section>
{{/if}}

{{#if isSingle}}
<section class="content-list">
{{#each rows}}<label><input type="radio" name="{{../step}}" value="{{uuid}}" {{#if (eq ../step "species")}}{{#if (eq ../draft.species uuid)}}checked{{/if}}{{/if}}{{#if (eq ../step "background")}}{{#if (eq ../draft.background uuid)}}checked{{/if}}{{/if}}{{#if (eq ../step "class")}}{{#if (eq ../draft.class uuid)}}checked{{/if}}{{/if}}{{#if (eq ../step "subclass")}}{{#if (eq ../draft.subclass uuid)}}checked{{/if}}{{/if}}><span><strong>{{name}}</strong><small>{{source}} · {{type}}</small></span></label>
{{else}}<p class="empty">No matching content was found. Add homebrew with <b>Custom Content</b> or enable a compatible D&D5e compendium.</p>{{/each}}
</section>
{{/if}}

{{#if isAbilities}}
<nav class="ability-methods">
{{#each abilityMethods}}<button type="button" class="{{#if active}}active{{/if}}" data-action="abilityMethod" data-method="{{value}}"><i class="fas {{icon}}"></i> {{label}}</button>{{/each}}
</nav>

{{#if bestFor}}<p class="best-hint"><span class="best-chip">Best for {{bestFor}}</span> {{#if bestPrimary}}<strong>{{bestPrimary}}</strong>{{#if bestSecondary}}, then {{bestSecondary}}{{/if}}{{else}}No class data for this class.{{/if}}</p>
{{else}}<p class="best-hint muted">Pick a class to see which abilities matter most.</p>{{/if}}

<div class="ability-toolbar">
  {{#if isPointBuy}}<span class="points {{#if (eq pointsLeft 0)}}done{{/if}}">Points left: <strong>{{pointsLeft}}</strong> / {{pointBudget}}</span>{{/if}}
  {{#if isStandard}}<span>Assign 15, 14, 13, 12, 10 and 8 — each once.</span>{{/if}}
  {{#if isRoll}}
    <button type="button" data-action="rollAbilities"><i class="fas fa-dice"></i> {{#if rolled.length}}Reroll All{{else}}Roll 4d6 ×6{{/if}}</button>
    {{#if rolled.length}}<span class="rolled">{{#each rolled}}<span class="roll-chip" title="Kept the highest three">{{#each dice}}<i class="{{#if dropped}}dropped{{/if}}">{{value}}</i>{{/each}}<b>{{total}}</b></span>{{/each}}</span>{{/if}}
  {{/if}}
  {{#if isManual}}<span>Type any score from 3 to 30.</span>{{/if}}
  {{#if canSuggest}}<button type="button" class="suggest" data-action="suggestAbilities"><i class="fas fa-wand-magic-sparkles"></i> Suggest for class</button>{{/if}}
</div>

<section class="ability-grid">
{{#each abilityRows}}
<div class="ability-card {{#if primary}}best{{/if}} {{#if secondary}}good{{/if}}">
  <div class="ability-head"><strong>{{label}}</strong><small>{{name}}</small>{{#if primary}}<span class="best-tag">Best</span>{{/if}}</div>
  {{#if ../isPointBuy}}
  <div class="pb-row">
    <button type="button" data-action="pointBuy" data-ability="{{key}}" data-delta="-1" {{#unless canDec}}disabled{{/unless}}><i class="fas fa-minus"></i></button>
    <span class="score">{{value}}</span>
    <button type="button" data-action="pointBuy" data-ability="{{key}}" data-delta="1" {{#unless canInc}}disabled{{/unless}}><i class="fas fa-plus"></i></button>
  </div>
  <small class="cost">Cost {{cost}}</small>
  {{/if}}
  {{#if ../isAssign}}
  <select name="assign-{{key}}">
    <option value="">—</option>
    {{#each options}}<option value="{{index}}" {{#if selected}}selected{{/if}}>{{value}}{{#if taken}} (from {{takenBy}}){{/if}}</option>{{/each}}
  </select>
  {{/if}}
  {{#if ../isManual}}<input type="number" name="{{key}}" value="{{value}}" min="3" max="30">{{/if}}
  {{#unless ../isManual}}{{#if ../isPointBuy}}{{else}}{{#if ../isAssign}}{{else}}<span class="score muted">—</span>{{/if}}{{/if}}{{/unless}}
  <div class="mod">{{#if ../isAssign}}{{#if assigned}}{{value}} ({{mod}}){{else}}&nbsp;{{/if}}{{else}}Modifier {{mod}}{{/if}}</div>
</div>
{{/each}}
</section>
<p class="ability-note">{{abilityNote}}</p>
{{/if}}

{{#if isMulti}}
<section class="content-list">
{{#each rows}}<label><input type="checkbox" name="{{../step}}" value="{{uuid}}" {{#if (eq ../step "feats")}}{{#if (includes ../draft.feats uuid)}}checked{{/if}}{{/if}}{{#if (eq ../step "spells")}}{{#if (includes ../draft.spells uuid)}}checked{{/if}}{{/if}}{{#if (eq ../step "equipment")}}{{#if (includes ../draft.equipment uuid)}}checked{{/if}}{{/if}}><span><strong>{{name}}</strong><small>{{source}} · {{type}}</small></span></label>
{{else}}<p class="empty">No matching content was found for this step.</p>{{/each}}
</section>
{{/if}}

{{#if isDetails}}<section class="form-area"><label>Character Details<textarea name="details" rows="15" placeholder="Appearance, personality, notes, and other details.">{{draft.details}}</textarea></label></section>{{/if}}

{{#if isReview}}<section class="review">{{#each review}}<div><strong>{{label}}</strong><span>{{value}}</span></div>{{/each}}<p>Creating the character makes a native D&D5e Character Actor and adds the selected content to it.</p></section>{{/if}}

<footer>
{{#if canBack}}<button type="button" data-action="back"><i class="fas fa-chevron-left"></i> Back</button>{{else}}<span></span>{{/if}}
{{#if isReview}}<button type="button" class="primary" data-action="create"><i class="fas fa-user-check"></i> Create Character</button>{{else}}<button type="button" class="primary" data-action="next">Next <i class="fas fa-chevron-right"></i></button>{{/if}}
</footer>
</main>
</div>